<%
links = Decidim::Nav::Link.with_navigable(navigable).ordered
top = []
children = {}

links.each do |link|
  if link.parent_id.present?
    children[link.parent_id] ||= []
    children[link.parent_id] << link
  else
    top << link
  end
end
%>

<% mobile ||= false %>

<% if mobile %>
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-language">
      <% if available_locales.length > 3 %>
        <div class="language-choose relative">
          <%= button_tag id: "mobile-menu-bar-trigger", data: { controller: "dropdown", target: "dropdown-menu-mobile-language" }, class: "dropdown__trigger" do %>
              <%= t("name", scope: "locale") %>
              <%= icon "arrow-down-s-line" %>
          <% end %>

          <div id="dropdown-menu-mobile-language" aria-hidden="true">
            <ul class="dropdown dropdown__bottom">
              <% (available_locales - [I18n.locale.to_s]).each do |locale| %>
                <li class="dropdown__item">
                  <%= link_to(locale_name(locale), decidim.locale_path(locale:), class: "dropdown__button", method: :post, tabindex: "-1") %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% else %>
        <% unless available_locales.length == 1 %>
          <div class="simple-locales-container flex flex-row gap-2">
            <% available_locales.each do |locale| %>
              <%
              cls = %w(locale p-2 text-md text-black hover:underline transition)
              cls << "active-locale" if current_locale == locale
              %>
              <%= link_to locale_name(locale),
                          decidim.locale_path(locale:),
                          method: :post,
                          role: "menuitem",
                          lang: locale,
                          class: cls.join(" ") %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render partial: "decidim/nav/shared/action_panel_link", collection: top, as: :link, locals: { children: children, mobile: mobile } %>

    <div class="mobile-search-container">
      <span class="mobile-search"><%= t(".search") %></span>
      <%= render partial: "layouts/decidim/header/main_search" %>
    </div>
  </div>
<% end %>

<%= render partial: "decidim/nav/shared/action_panel_link", collection: top, as: :link, locals: { children: children } unless mobile %>

